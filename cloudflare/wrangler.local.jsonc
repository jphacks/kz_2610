{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "meshinowa-api",
  "main": "src/index.js",
  "compatibility_date": "2026-10-24",
  "workers_dev": false,
  "observability": {
    "enabled": false,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "meshinowa",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "meshinowa-review-photos",
    },
  ],
  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 20,
        "period": 60,
      },
    },
  ],
}
